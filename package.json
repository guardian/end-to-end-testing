{
  "name": "end-to-end-testing",
  "version": "0.1.0",
  "description": "Shared Docker images and Testcontainers building blocks for end-to-end stacks.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "testcontainers": "^12.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "testcontainers": "^12.2.1",
    "typescript": "~5.9.3"
  }
}